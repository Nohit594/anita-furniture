# ─── Database ───────────────────────────────
MONGODB_URI=

# ─── NextAuth ───────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# ─── Google OAuth ───────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Admin ──────────────────────────────────
# This email becomes admin automatically on first login
ADMIN_EMAIL=

# ─── Razorpay ───────────────────────────────
# Get keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Google Maps ─────────────────────────────
# Enable Maps JavaScript API + Places API at https://console.cloud.google.com/apis
# Then create an API key (separate from OAuth) and add it here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── freeimage.host ─────────────────────────
# Get free API key at https://freeimage.host/page/api
FREEIMAGE_HOST_API_KEY=
